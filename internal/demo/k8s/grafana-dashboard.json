{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Per-version HPA scaling metrics for temporal-worker-controller demo",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HPA",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"default\"}",
          "legendFormat": "{{horizontalpodautoscaler}} current",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"default\"}",
          "legendFormat": "{{horizontalpodautoscaler}} desired",
          "refId": "B"
        }
      ],
      "title": "HPA Replicas (current vs desired)",
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"default\"}",
          "legendFormat": "{{horizontalpodautoscaler}}",
          "refId": "A"
        }
      ],
      "title": "HPA Current Replicas",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Slot Utilization",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "temporal_slot_utilization{temporal_worker_deployment_name=\"default_helloworld\"}",
          "legendFormat": "{{worker_type}} - {{temporal_worker_deployment_name}} / {{temporal_worker_build_id}}",
          "refId": "A"
        }
      ],
      "title": "Activity Slot Utilization per version (0=idle, 1=saturated)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Backlog Count",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (worker_build_id) (approximate_backlog_count{namespace=\"default\", task_type=\"Workflow\", worker_deployment_name=\"default_helloworld\", worker_build_id!=\"\"})",
          "legendFormat": "{{worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (temporal_worker_build_id) (temporal_cloud_v1_approximate_backlog_count{task_type=\"Workflow\", temporal_worker_deployment_name=\"default_helloworld\"})",
          "legendFormat": "{{temporal_worker_build_id}}",
          "refId": "B"
        }
      ],
      "title": "Workflow Task Backlog per version",
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (worker_build_id) (approximate_backlog_count{namespace=\"default\", task_type=\"Activity\", worker_deployment_name=\"default_helloworld\", worker_build_id!=\"\"})",
          "legendFormat": "{{worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (temporal_worker_build_id) (temporal_cloud_v1_approximate_backlog_count{task_type=\"Activity\", temporal_worker_deployment_name=\"default_helloworld\"})",
          "legendFormat": "{{temporal_worker_build_id}}",
          "refId": "B"
        }
      ],
      "title": "Activity Task Backlog per version",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 104,
      "title": "Task Dispatch Rate",
      "type": "row"
    },
    {
      "description": "Tasks successfully matched to a poller, per second. Query A is the self-hosted series (poll_success, a counter, so rate() is applied) grouped by task queue AND worker build ID; series with no build ID are labelled unversioned. Query B is the Temporal Cloud series, which is already a per-second rate and must not be wrapped in rate(); it is grouped by task queue only, because temporal_cloud_v1_poll_success_count does not carry a build ID label.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (taskqueue, worker_build_id) (rate(poll_success{namespace=\"default\", task_type=\"Workflow\"}[1m])), \"worker_build_id\", \"unversioned\", \"worker_build_id\", \"^$\")",
          "legendFormat": "{{taskqueue}} / {{worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (temporal_task_queue) (temporal_cloud_v1_poll_success_count{task_type=\"Workflow\"})",
          "legendFormat": "{{temporal_task_queue}}",
          "refId": "B"
        }
      ],
      "title": "Workflow Task Dispatch Rate per task queue / build ID",
      "type": "timeseries"
    },
    {
      "description": "Tasks successfully matched to a poller, per second. Query A is the self-hosted series (poll_success, a counter, so rate() is applied) grouped by task queue AND worker build ID; series with no build ID are labelled unversioned. Query B is the Temporal Cloud series, which is already a per-second rate and must not be wrapped in rate(); it is grouped by task queue only, because temporal_cloud_v1_poll_success_count does not carry a build ID label.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (taskqueue, worker_build_id) (rate(poll_success{namespace=\"default\", task_type=\"Activity\"}[1m])), \"worker_build_id\", \"unversioned\", \"worker_build_id\", \"^$\")",
          "legendFormat": "{{taskqueue}} / {{worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "sum by (temporal_task_queue) (temporal_cloud_v1_poll_success_count{task_type=\"Activity\"})",
          "legendFormat": "{{temporal_task_queue}}",
          "refId": "B"
        }
      ],
      "title": "Activity Task Dispatch Rate per task queue / build ID",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 103,
      "title": "Raw Slot Gauges",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "temporal_worker_task_slots_used{worker_type=\"ActivityWorker\", task_queue=\"default/helloworld\"}",
          "legendFormat": "used {{pod}} {{temporal_worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "temporal_worker_task_slots_available{worker_type=\"ActivityWorker\", task_queue=\"default/helloworld\"}",
          "legendFormat": "available {{pod}} {{temporal_worker_build_id}}",
          "refId": "B"
        }
      ],
      "title": "Activity Slot Gauges (per pod)",
      "type": "timeseries"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "temporal_worker_task_slots_used{worker_type=\"WorkflowWorker\", task_queue=\"default/helloworld\"}",
          "legendFormat": "used {{pod}} {{temporal_worker_build_id}}",
          "refId": "A"
        },
        {
          "expr": "temporal_worker_task_slots_available{worker_type=\"WorkflowWorker\", task_queue=\"default/helloworld\"}",
          "legendFormat": "available {{pod}} {{temporal_worker_build_id}}",
          "refId": "B"
        }
      ],
      "title": "Workflow Slot Gauges (per pod)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["temporal", "hpa", "worker-controller"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Temporal Worker Controller — HPA Scaling",
  "uid": "twc-hpa-scaling",
  "version": 1
}
