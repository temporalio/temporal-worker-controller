# Skaffold environment variables - EXAMPLE FILE (local Temporal dev server)
#
# To use this file:
# 1. Copy it to 'skaffold.env': cp skaffold.local.example.env skaffold.env
# 2. The values below work as-is against `temporal server start-dev` on your host
# 3. The skaffold.env file is gitignored and won't be committed
#
# This file is loaded automatically by Skaffold when running skaffold commands.
#
# For Temporal Cloud instead, use skaffold.cloud.example.env.
#
# Start the server on the host first, and leave it running:
#
#   make start-temporal-server
#
# It binds 0.0.0.0, enables the versioning dynamic configs the controller needs, and
# shortens the two drainage knobs so a v1 -> v2 rollout doesn't take twice as long.
# Check there is exactly one listener before going further -- start-dev does NOT fail
# when port 7233 is already taken, it just silently receives no traffic:
#
#   lsof -nP -iTCP:7233 -sTCP:LISTEN

# The dev server's only namespace
TEMPORAL_NAMESPACE=default

# host.minikube.internal is how a pod reaches a process listening on the host.
# Verify it before going further:
#   kubectl run nettest --rm -i --restart=Never --image=busybox:1.36 -- \
#     nc -z -w 5 host.minikube.internal 7233 && echo REACHABLE
TEMPORAL_ADDRESS=host.minikube.internal:7233

# Leaving all three empty makes ConnectionSpec.AuthMode() resolve to NO_CREDENTIALS,
# so the controller injects no TLS or API-key env vars into the worker pods. The
# worker's envconfig client then defaults to plaintext, which is what a dev server
# expects.
TEMPORAL_MTLS_SECRET_NAME=""
TEMPORAL_API_KEY_SECRET_NAME=""
TEMPORAL_API_KEY_SECRET_KEY=""

# Kubernetes context to use for deployment
SKAFFOLD_KUBE_CONTEXT=minikube
